# Copy to .env to override. Only WEB_PORT matters for `docker-compose up`;
# the rest are used by docker-compose.dev.yml (tests, psql, Redpanda Console).
WEB_PORT=8080
API_PORT=13000
POSTGRES_PORT=15432
REDPANDA_PORT=19092
CONSOLE_PORT=18088
# Silence after which a gateway counts as offline and its values show as stale.
STALE_AFTER_MS=30000
